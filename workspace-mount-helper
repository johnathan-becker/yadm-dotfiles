#!/usr/bin/env python3
# workspace-mount-helper — must be run as root (called via sudo by workspace-mount)
# Uses open_tree + move_mount syscalls to bind a host directory into a
# running container's mount namespace without needing the source path to
# exist inside the container.
#
# Usage:
#   workspace-mount-helper link   <src> <target> <container-pid>
#   workspace-mount-helper unlink <target> <container-pid>

import ctypes
import ctypes.util
import os
import sys

libc = ctypes.CDLL(ctypes.util.find_library('c'), use_errno=True)

# x86_64 syscall numbers (kernel 5.2+)
SYS_open_tree  = 428
SYS_move_mount = 429

AT_FDCWD                = -100
OPEN_TREE_CLONE         = 1
MOVE_MOUNT_F_EMPTY_PATH = 0x00000004


def open_tree(path):
    fd = libc.syscall(SYS_open_tree,
                      ctypes.c_int(AT_FDCWD),
                      ctypes.c_char_p(path.encode()),
                      ctypes.c_uint(OPEN_TREE_CLONE | os.O_CLOEXEC))
    if fd < 0:
        err = ctypes.get_errno()
        raise OSError(err, f"open_tree {path!r}: {os.strerror(err)}")
    return fd


def move_mount(src_fd, target):
    ret = libc.syscall(SYS_move_mount,
                       ctypes.c_int(src_fd),   ctypes.c_char_p(b""),
                       ctypes.c_int(AT_FDCWD), ctypes.c_char_p(target.encode()),
                       ctypes.c_uint(MOVE_MOUNT_F_EMPTY_PATH))
    if ret < 0:
        err = ctypes.get_errno()
        raise OSError(err, f"move_mount -> {target!r}: {os.strerror(err)}")


def enter_mnt_namespace(pid):
    path = f"/proc/{pid}/ns/mnt"
    fd = os.open(path, os.O_RDONLY | os.O_CLOEXEC)
    try:
        ret = libc.setns(ctypes.c_int(fd), ctypes.c_int(0))
        if ret < 0:
            err = ctypes.get_errno()
            raise OSError(err, f"setns {path!r}: {os.strerror(err)}")
    finally:
        os.close(fd)


def cmd_link(src, target, pid):
    # Capture the source as a detached mount clone BEFORE entering the
    # container's namespace — resolved in the host filesystem.
    src_fd = open_tree(src)
    try:
        enter_mnt_namespace(pid)
        os.makedirs(target, exist_ok=True)
        move_mount(src_fd, target)
    finally:
        os.close(src_fd)


def cmd_unlink(target, pid):
    enter_mnt_namespace(pid)
    ret = libc.umount2(ctypes.c_char_p(target.encode()), ctypes.c_int(0))
    if ret < 0:
        err = ctypes.get_errno()
        raise OSError(err, f"umount2 {target!r}: {os.strerror(err)}")
    try:
        os.rmdir(target)
    except OSError:
        pass


if __name__ == "__main__":
    # argv: script cmd [args...]
    # link:   script link <src> <target> <pid>   → sys.argv[1..4]
    # unlink: script unlink <target> <pid>        → sys.argv[1..3]
    try:
        cmd = sys.argv[1]
        if cmd == "link":
            cmd_link(src=sys.argv[2], target=sys.argv[3], pid=int(sys.argv[4]))
        elif cmd == "unlink":
            cmd_unlink(target=sys.argv[2], pid=int(sys.argv[3]))
        else:
            raise ValueError
    except (IndexError, ValueError):
        print(f"Usage: {sys.argv[0]} link <src> <target> <pid>", file=sys.stderr)
        print(f"       {sys.argv[0]} unlink <target> <pid>", file=sys.stderr)
        sys.exit(1)
    except OSError as e:
        print(f"error: {e}", file=sys.stderr)
        sys.exit(1)
